# GEMINI_API_KEY: Required for Gemini AI API calls (Agent orchestration & Google Search Grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Platform API Credentials (for direct authorized connectors)
# REDDIT_USER_AGENT="AIBuyerHunter/1.0"
# BING_SEARCH_API_KEY=""
# LINKEDIN_ACCESS_TOKEN=""
# X_BEARER_TOKEN=""
# META_GRAPH_TOKEN=""
# UPWORK_API_KEY=""
# N8N_WEBHOOK_URL=""

# Security & Session Configuration
# SESSION_SECRET="replace-with-strong-random-secret"
# ADMIN_DEFAULT_PASSWORD="change-on-first-login"
